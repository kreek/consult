{
  "name": "consult-eval",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "eval": "do-eval tui --project .",
    "eval:list": "do-eval list --project .",
    "eval:trial": "do-eval trial --project .",
    "eval:regression": "do-eval regression allSkills --project .",
    "eval:baseline": "do-eval baseline allSkills --project .",
    "eval:web": "do-eval ui --project .",
    "check": "do-eval check --project .",
    "regression": "pnpm run eval:regression",
    "regression:smoke": "do-eval regression smoke --project .",
    "regression:core": "CONSULT_EVAL_EPOCHS=3 do-eval regression core --project .",
    "regression:routing": "CONSULT_EVAL_EPOCHS=3 do-eval regression routing --project .",
    "regression:large": "do-eval regression largeProject --project .",
    "regression:all": "do-eval regression allSkills --project .",
    "regression:check": "do-eval regression regressionCheck --project .",
    "baseline": "pnpm run eval:baseline",
    "baseline:smoke": "do-eval baseline smoke --project .",
    "baseline:core": "CONSULT_EVAL_EPOCHS=3 do-eval baseline core --project .",
    "baseline:routing": "CONSULT_EVAL_EPOCHS=3 do-eval baseline routing --project .",
    "baseline:large": "do-eval baseline largeProject --project .",
    "baseline:all": "do-eval baseline allSkills --project .",
    "baseline:link": "do-eval baseline linkShortener --project .",
    "trial": "pnpm run eval:trial --",
    "list": "pnpm run eval:list",
    "view": "pnpm run eval:web",
    "test": "vitest run test",
    "typecheck": "tsc --noEmit",
    "tui": "pnpm run eval"
  },
  "dependencies": {
    "do-eval": "file:../../do-eval"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  }
}
